# Vitistack Proxmox Operator Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable JSON logging format (true/false)
LOG_JSON=false

# Enable colored log output (true/false)
LOG_COLORIZE_LINE=true

# Include caller information in logs (true/false)
LOG_ADD_CALLER=true

# Disable stacktrace in error logs (true/false)
LOG_DISABLE_STACKTRACE=false

# Unescape multiline strings in logs (true/false)
LOG_UNESCAPED_MULTILINE=false

# =============================================================================
# PROXMOX CONFIGURATION (REQUIRED)
# =============================================================================

# Proxmox API endpoint URL (base URL without /api2/json)
PROXMOX_ENDPOINT=https://your-proxmox-host:8006/api2/json

# Proxmox authentication username (e.g., root@pam or user@pve)
PROXMOX_USERNAME=root@pam

# Proxmox authentication password
PROXMOX_PASSWORD=your-proxmox-password

# Alternative: API Token authentication (instead of username/password)
# PROXMOX_TOKEN_ID=your-token-id
# PROXMOX_TOKEN_SECRET=your-token-secret

# Skip TLS certificate verification (use true for self-signed certificates)
PROXMOX_INSECURE_TLS=false

# Starting VM ID for new virtual machines (default: 2000)
PROXMOX_VM_ID_START=2000

# Node selection strategy for VM placement (first, random, round-robin)
PROXMOX_NODE_SELECTION=first

# Comma-separated list of allowed Proxmox nodes (empty means all nodes allowed)
PROXMOX_ALLOWED_NODES=

# Default storage pool for VM disks (e.g., local-lvm, local-zfs, ceph)
PROXMOX_DEFAULT_STORAGE=local-lvm

# Default network bridge for VM network interfaces (e.g., vmbr0, vmbr1)
PROXMOX_DEFAULT_NETWORK=vmbr0

# Default CPU type for VMs (e.g., x86-64-v2-AES, host, kvm64)
PROXMOX_DEFAULT_CPU_TYPE=x86-64-v2-AES

# Enable NUMA for VMs (true/false)
PROXMOX_ENABLE_NUMA=true

# SCSI controller type (virtio-scsi-single, virtio-scsi-pci, lsi, etc.)
PROXMOX_SCSI_CONTROLLER=virtio-scsi-single

# Enable QEMU Guest Agent (true/false)
PROXMOX_ENABLE_QEMU_AGENT=true

# Start VM immediately after creation (true/false)
PROXMOX_START_ON_CREATE=true

# =============================================================================
# VITISTACK CONFIGURATION
# =============================================================================

# Name of the machine provider to use
NAME_MACHINE_PROVIDER=proxmox-provider

# IP source configuration
IP_SOURCE=vmi

# Vitistack name/namespace
VITISTACK_NAME=default

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable development mode (true/false)
DEVELOPMENT=false
